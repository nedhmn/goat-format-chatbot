{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignore": [
    "tools/oxlint/anti-slop/**",
    ".agents/skills/brand/**",
    "**/*.gen.ts",
    "**/convex/_generated/**"
  ],
  "ignoreDependencies": ["@tanstack/intent"],
  "workspaces": {
    "packages/*": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/evals": {
      "entry": ["src/run.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/backend": {
      "project": ["convex/**/*.ts", "test/**/*.ts"]
    },
    "apps/web": {
      "entry": ["src/specimen.tsx", "scripts/*.ts"],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts"]
    }
  }
}
